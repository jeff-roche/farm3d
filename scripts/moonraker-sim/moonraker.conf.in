# Moonraker config for the A0.1 simulator. sim.sh replaces @PORT@ and
# @TRUSTED@ and writes the result into the runtime directory.

[server]
host: 0.0.0.0
port: @PORT@
klippy_uds_address: /opt/printer_data/run/klipper.sock

[machine]
provider: none
validate_service: False
validate_config: False

[authorization]
# `trusted` mode trusts every client. `apikey` mode names a range no client
# comes from, so every request needs the API key (`sim.sh api-key`).
trusted_clients:
  @TRUSTED@
cors_domains:
  *
